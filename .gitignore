# node
**/node_modules/
**/.expo/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# iOS build junk
**/ios/Pods/
**/ios/build/
**/ios/DerivedData/
**/ios/.xcode.env.local
**/ios/*.xcworkspace/xcuserdata/
**/ios/*.xcodeproj/xcuserdata/
**/ios/*.xcodeproj/project.xcworkspace/xcuserdata/

# Android build junk
**/android/build/
**/android/app/build/
**/android/.gradle/
**/android/local.properties

# Python
**/__pycache__/
**/*.pyc
**/.venv/
**/venv/
**/.pytest_cache/

# Logs / OS
*.log
.DS_Store

# Absorbed inner .git dirs
**/.git.absorbed_*

# Secrets — never commit
*.env
.env
.env.*
**/secrets/
**/*token*
**/*credential*
!**/*token*.py
!**/*token*.md

# Build artifacts + extracted zips + data dumps (root)
*.zip
/react_web_extracted/
/ui_extracted/
/data/
/.cruft_quarantine_*/
